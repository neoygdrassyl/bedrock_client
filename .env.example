# Copy this file to .env.
# Keep the real .env private. Vite loads .env* normally; exported variables win.
# Values prefixed with VITE_ are embedded in the browser bundle; do not put private secrets here.

VITE_APP_URL=http://localhost:3000
# Used by the development proxy only when VITE_API_URL is relative.
BACKOFFICE_GATE_URL=http://127.0.0.1:3001
VITE_API_URL="/api"
VITE_GLOBAL_ID="cb1"
VITE_API_PROF_URL="https://server.prof.curaduria1bucaramanga.com/api"
# FUN 5.2 professional search: sources tried in order (registry = BD PROFESIONALES, external = VITE_API_PROF_URL).
# Unknown names are ignored; empty means the default.
VITE_PROFESSIONAL_SEARCH_SOURCES="registry,external"
VITE_API_EMAIL_URL="https://emails.dovela-services.com/api"
VITE_BUILD_ANALYZE="false"

# Optional: public browser address for Dovela Central (no credentials).
# Not needed to run locally; leave empty when Central is not available.
# Synchronization uses the backend Central connection, not this browser link.
VITE_DOVELA_CENTRAL_URL=

# Extra hosts allowed by Vite dev/preview (comma-separated, e.g. temporary tunnels)
VITE_ALLOWED_HOSTS=
